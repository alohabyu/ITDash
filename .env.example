# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (.env.local ไม่ถูก commit)
# ค่าลับทั้งหมดใช้ฝั่ง server เท่านั้น — ห้ามใส่ prefix NEXT_PUBLIC_
# ระบบไหนเว้นว่างไว้ การ์ดของระบบนั้นจะแสดงข้อมูลตัวอย่าง (ป้าย "sample")

# mock = ข้อมูลตัวอย่างทั้งหมด, live = ดึงจากระบบจริง
DATA_SOURCE=live
# เขตเวลาที่ใช้แสดงผล
DASH_TIMEZONE=Asia/Bangkok
# ระยะเวลารอแต่ละระบบ (ms)
SOURCE_TIMEOUT_MS=8000

# ---------- Zabbix: hosts, problems, storage, incident banner ----------
ZABBIX_URL=https://zabbix.example.local
ZABBIX_TOKEN=
# จำกัดเฉพาะ host group (ใส่ groupid คั่นด้วย ,) — เว้นว่าง = ทุกกลุ่มที่ user เห็น
ZABBIX_HOSTGROUP_IDS=
# แสดงเฉพาะ filesystem ที่ใหญ่อย่างน้อยกี่ TB
ZABBIX_STORAGE_MIN_TB=1

# ---------- Prometheus: WAN throughput, service health, probe latency ----------
PROM_URL=http://prometheus.example.local:9090
# ถ้ามี auth proxy: ใช้ token หรือ user/password อย่างใดอย่างหนึ่ง
PROM_TOKEN=
PROM_USER=
PROM_PASSWORD=
# PromQL — แก้ให้ตรงกับ exporter ที่ใช้ (ดู docs/INTEGRATIONS.md)
# PROM_Q_WAN_IN=sum(rate(ifHCInOctets{instance="core-sw-01",ifName="xe-0/0/0"}[5m])) * 8 / 1e6
# PROM_Q_WAN_OUT=sum(rate(ifHCOutOctets{instance="core-sw-01",ifName="xe-0/0/0"}[5m])) * 8 / 1e6
# PROM_Q_PROBE=probe_success{job="blackbox-http"}
# PROM_Q_LATENCY=avg(probe_duration_seconds{job="blackbox-http"}) * 1000
# PROM_PROBE_NAME_LABEL=instance

# ---------- Elasticsearch: event log, log-error KPI ----------
ES_URL=https://elastic.example.local:9200
ES_API_KEY=
# หรือ ES_USER / ES_PASSWORD
ES_INDEX=logs-*
# ชื่อ field (ค่าเริ่มต้นตาม ECS — Filebeat / Elastic Agent)
# ES_TIME_FIELD=@timestamp
# ES_LEVEL_FIELD=log.level
# ES_MESSAGE_FIELD=message
# ES_SOURCE_FIELD=host.name
# กรองเพิ่มด้วย Lucene query เช่นตัด log ที่ไม่สำคัญออก
# ES_FILTER=NOT service.name:nginx-access

# ---------- Veeam Backup & Replication: backup jobs ----------
VEEAM_URL=https://vbr.example.local:9419
VEEAM_USERNAME=
VEEAM_PASSWORD=
# ต้องตรงกับเวอร์ชัน B&R: 1.2-rev0 (v12.x), 1.3-rev1 (v13.0.1) — ดูที่ /swagger ของเครื่อง
VEEAM_API_VERSION=1.3-rev1

# ---------- Cohesity: backup jobs (protection groups) ----------
COHESITY_URL=https://cohesity.example.local
COHESITY_API_KEY=
# หรือ COHESITY_USERNAME / COHESITY_PASSWORD / COHESITY_DOMAIN=LOCAL

# ใบรับรองของ CA ภายใน / self-signed (Veeam, Cohesity มักเป็นแบบนี้)
# NODE_EXTRA_CA_CERTS=/etc/itdash/ca-bundle.pem
