# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ไฟล์ .env.local ไม่ถูก commit)
# ค่าลับทั้งหมดใช้ฝั่ง server เท่านั้น — ห้ามใส่ prefix NEXT_PUBLIC_

# mock = ใช้ข้อมูลตัวอย่าง, live = ดึงจากระบบจริง
DATA_SOURCE=mock

# Zabbix (API token ของ user read-only)
ZABBIX_URL=https://zabbix.example.local
ZABBIX_TOKEN=

# Uptime Kuma (slug ของ status page)
KUMA_URL=https://status.example.local
KUMA_STATUS_SLUG=itdash

# GLPI 11 (OAuth client, grant type: client credentials)
GLPI_URL=https://glpi.example.local
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=

# Veeam Backup & Replication (บัญชี role Veeam Backup Viewer)
VEEAM_URL=https://vbr.example.local:9419
VEEAM_API_VERSION=1.3-rev1
VEEAM_USERNAME=
VEEAM_PASSWORD=

# ใบรับรองของ CA ภายในองค์กร (ถ้ามี)
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/org-ca.pem
